# Backend environment variables (copy to .env — never commit secrets)
APP_NAME=Telecom Churn Agent API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api

# SQLAlchemy URL. Production MUST be PostgreSQL:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# psycopg2 URLs (postgresql+psycopg2://) remain accepted.
# Development/testing may set an explicit sqlite:/// path. Production never
# falls back to SQLite.
DATABASE_URL=postgresql+psycopg://churn_user:churn_password@127.0.0.1:5432/telecom_churn
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
# Managed PostgreSQL: require or verify-full. Leave empty for local Docker.
DB_SSLMODE=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Auth0 — JWT validation only. Never put a client secret or Management API
# token in this file. Domain / audience / issuer are not secrets.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://telecom-churn-api
AUTH0_ISSUER=
AUTH0_ROLES_CLAIM=https://retention-intelligence.app/roles

# LLM — backend only, never exposed to the frontend.
# Leave LLM_PROVIDER as "none" (or leave the key blank) to run the retention
# agent on its deterministic strategy engine; recommendations still work.
# Set to "openai_compatible" for OpenAI, OpenRouter, Groq, Ollama, vLLM, etc.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=20

# Number of SHAP drivers the retention strategy engine evaluates per customer.
AGENT_EVIDENCE_DRIVER_COUNT=10

# Optional override. Leave empty to use ml/models next to the ML package.
ML_MODELS_DIR=
MODEL_PATH=
MODEL_VERSION=1.0.0
