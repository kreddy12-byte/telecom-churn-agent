# Root environment template — copy values into backend/.env and frontend/.env as needed.
# Never commit a real .env with secrets.

# Local Docker Postgres (docker-compose.yml). Do not reuse these in production.
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=churn_password
POSTGRES_DB=telecom_churn

# --- Backend (see also backend/.env.example) ---
APP_NAME=Telecom Churn Agent API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api

DATABASE_URL=postgresql+psycopg://churn_user:churn_password@127.0.0.1:5432/telecom_churn
DB_ECHO=false
DB_SSLMODE=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Auth0 — JWT validation only. Never put a client secret here.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://telecom-churn-api
AUTH0_ISSUER=
AUTH0_ROLES_CLAIM=https://retention-intelligence.app/roles

# LLM — backend only. "none" runs the retention agent's deterministic engine.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=20
AGENT_EVIDENCE_DRIVER_COUNT=10

# Optional override. Leave empty to use ml/models next to the ML package.
ML_MODELS_DIR=
MODEL_PATH=
MODEL_VERSION=1.0.0

# --- Frontend (see also frontend/.env.example) ---
VITE_API_BASE_URL=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://telecom-churn-api
VITE_AUTH0_GOOGLE_ENABLED=false
VITE_AUTH0_MICROSOFT_ENABLED=false
VITE_AUTH0_GITHUB_ENABLED=false
VITE_AUTH0_EMAIL_ENABLED=false
VITE_AUTH0_DATABASE_ENABLED=false
VITE_AUTH0_SIGNUP_ENABLED=true
