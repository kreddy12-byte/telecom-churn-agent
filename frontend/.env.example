# Frontend public env (Vite exposes only VITE_* vars to the browser).
# Copy to frontend/.env and fill in your Auth0 SPA values.
# Never put a client secret, private key, database password, or LLM key here.

# Leave empty to use the Vite dev proxy to http://127.0.0.1:8000
VITE_API_BASE_URL=

# Auth0 SPA settings — these are public client values, not secrets.
# Audience must match the Auth0 API identifier and backend AUTH0_AUDIENCE.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://telecom-churn-api

# Set to true only after the matching Auth0 connection exists.
VITE_AUTH0_GOOGLE_ENABLED=false
VITE_AUTH0_MICROSOFT_ENABLED=false
VITE_AUTH0_GITHUB_ENABLED=false
VITE_AUTH0_EMAIL_ENABLED=false
VITE_AUTH0_DATABASE_ENABLED=false
# Signup uses Auth0 Universal Login (screen_hint=signup). No passwords here.
VITE_AUTH0_SIGNUP_ENABLED=true

VITE_AUTH0_GOOGLE_CONNECTION=google-oauth2
VITE_AUTH0_MICROSOFT_CONNECTION=windowslive
VITE_AUTH0_GITHUB_CONNECTION=github
VITE_AUTH0_DATABASE_CONNECTION=Username-Password-Authentication
